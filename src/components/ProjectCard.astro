---
import { Card as ShadcnCard } from './ui/card'

const {
  as: Tag = 'a',
  class: className,
  href,
  heading,
  subheading,
  imagePath,
  altText,
  skills
} = Astro.props
console.log(skills)

---

<Tag href={href} class={`${className}`}>
  <ShadcnCard
    className={`group relative w-full max-w-2xl overflow-hidden shadow-lg transition-all duration-300 ease-in-out hover:bg-black ${
      href ? 'cursor-pointer' : ''
    }`}
  >
    <div class="relative aspect-video ">
      <img
        src={imagePath}
        alt={altText}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-102"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/30 transition-opacity duration-300 group-hover:bg-black/60" />
    </div>

    <div class="p-6 transition-colors duration-300 group-hover:bg-black group-hover:text-white">
      <h1 class="text-2xl font-bold transition-colors duration-300 group-hover:text-white">{heading}</h1>
      <h2 class="mt-2 text-lg text-gray-600 transition-colors duration-300 group-hover:text-gray-300">{subheading}</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {skills.map((skill: string) => (
          <span class="text-sm bg-orange-400 text-white-800 px-2 py-1 rounded-full" >
            {skill}
          </span>
        ))}
    </div>

    <slot />
  </ShadcnCard>
</Tag>